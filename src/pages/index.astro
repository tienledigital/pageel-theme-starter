---
import BaseLayout from '../theme/layouts/BaseLayout.astro';
import ThemeToggle from '../theme/components/layout/ThemeToggle.astro';
---

<BaseLayout title="Pageel Theme Starter | Advanced Theme Architecture">
  <!-- Decorative background elements -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] rounded-full bg-accent/5 blur-[120px]"></div>
    <div class="absolute top-[20%] -right-[10%] w-[30%] h-[30%] rounded-full bg-accent/10 blur-[100px]"></div>
  </div>

  <main class="min-h-screen py-20 px-6 md:px-12 max-w-6xl mx-auto font-sans antialiased text-fg">
    <!-- Hero Section -->
    <header class="mb-24 text-center">
      <div class="inline-flex items-center gap-2 mb-8 px-4 py-1.5 rounded-full bg-surface border border-border text-xs font-bold tracking-widest uppercase text-accent shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
        </span>
        v1.0.0 Stable
      </div>
      
      <h1 class="text-6xl md:text-8xl font-black tracking-tighter mb-8 leading-[1.1]">
        Design <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent/60">Swappable.</span><br/>
        Content Stable.
      </h1>
      
      <p class="text-xl md:text-2xl text-muted max-w-3xl mx-auto leading-relaxed mb-12">
        A revolutionary Astro foundation that separates your visual universe from your core logic. 
        <span class="text-fg font-medium">Built for the age of Agentic Coding.</span>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://theme.pageel.dev/" class="px-8 py-4 bg-accent text-on-accent rounded-full font-bold text-lg hover:scale-105 transition-transform shadow-lg shadow-accent/20">
          Get Started
        </a>
        <a href="https://github.com/pageel/pageel-theme-kit" class="px-8 py-4 bg-surface border border-border rounded-full font-bold text-lg hover:bg-border transition-colors">
          View Repository
        </a>
      </div>
    </header>

    <!-- Architecture Section -->
    <section class="mb-32">
      <div class="flex flex-col md:flex-row items-end justify-between gap-6 mb-12">
        <div class="max-w-xl">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">The Blueprint.</h2>
          <p class="text-muted text-lg">Our architecture is split into two worlds: The volatile UI and the unshakeable Content.</p>
        </div>
        <div class="text-sm font-mono text-muted py-2 px-4 bg-surface rounded-lg border border-border">
          root/src/
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Explorer Visual -->
        <div class="lg:col-span-2 bg-surface rounded-3xl border border-border p-2 shadow-2xl overflow-hidden shadow-accent/5">
          <div class="bg-border/20 px-6 py-4 flex items-center gap-2 border-b border-border">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-500/50"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/50"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/50"></div>
            </div>
            <span class="text-xs font-mono text-muted ml-4 lowercase italic tracking-tight">pageel-theme-kit — terminal</span>
          </div>
          <div class="p-8 font-mono text-sm overflow-auto">
            <pre class="leading-relaxed"><span class="text-muted">src/</span>
├── <span class="bg-accent/10 text-accent px-1 rounded font-bold">theme/</span>               <span class="text-accent italic font-bold">// 🔄 UI UNIVERSE (The part you swap)</span>
│   ├── styles/          <span class="text-muted italic">// Design Tokens (Global, Semantic)</span>
│   ├── components/      <span class="text-muted italic">// Visual primitives</span>
│   └── layouts/         <span class="text-muted italic">// Structural templates</span>
├── <span class="font-bold">pages/</span>               <span class="text-muted italic">// ✅ ROUTES (Stable)</span>
├── <span class="font-bold">content/</span>             <span class="text-muted italic">// ✅ DATA (Stable)</span>
└── <span class="text-muted">theme.config.ts</span>      <span class="text-muted italic">// ⚙️ Integration logic</span></pre>
          </div>
        </div>

        <!-- Info Card -->
        <div class="flex flex-col gap-6">
          <div class="flex-1 p-8 bg-surface rounded-3xl border border-border hover:border-accent/50 transition-colors">
            <h3 class="font-bold text-xl mb-4">Pure Separation</h3>
            <p class="text-muted leading-relaxed">By keeping visual code in <code class="text-accent underline font-mono">/theme</code>, you can rotate your entire site's identity without ever touching your routes or markdown files.</p>
          </div>
          <div class="p-8 bg-accent text-on-accent rounded-3xl shadow-xl shadow-accent/10">
            <div class="text-4xl mb-4">🚀</div>
            <p class="font-bold leading-tight">Ready to build something extraordinary?</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Detailed Features Grid -->
    <section class="mb-32">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Core Ecosystem</h2>
        <p class="text-muted text-lg max-w-2xl mx-auto">Standardized patterns for modern web development.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { title: "Semantic Tokens", icon: "🎨", color: "bg-blue-500/10 text-blue-500", desc: "Design systems that actually scale." },
          { title: "A11y First", icon: "♿", color: "bg-green-500/10 text-green-500", desc: "Inclusive by design, not by after-thought." },
          { title: "AI Optimized", icon: "🤖", color: "bg-purple-500/10 text-purple-500", desc: "Scaffolded for agentic workflows." },
          { title: "Ultra Fast", icon: "⚡", color: "bg-yellow-500/10 text-yellow-500", desc: "Optimized Astro build performance." }
        ].map(item => (
          <div class="p-8 bg-surface rounded-3xl border border-border hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class={`w-12 h-12 ${item.color} rounded-2xl flex items-center justify-center text-2xl mb-6`}>
              {item.icon}
            </div>
            <h3 class="font-bold text-lg mb-2">{item.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="pt-12 border-t border-border flex flex-col md:flex-row justify-between items-center gap-12 text-sm">
      <div class="flex items-center gap-6">
        <a href="https://github.com/pageel/pageel-theme-kit" class="font-bold flex items-center gap-2 hover:text-accent transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.298 24 12c0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
        <a href="https://theme.pageel.dev/" class="font-bold flex items-center gap-2 hover:text-accent transition-colors">
          Documentation
        </a>
      </div>
      <div class="px-4 py-2 bg-surface border border-border rounded-full text-[10px] font-mono uppercase tracking-widest text-muted">
        Build with <span class="text-red-500 mx-1">❤</span> for the Open Source Community
      </div>
    </footer>
  </main>
  <ThemeToggle />
</BaseLayout>
